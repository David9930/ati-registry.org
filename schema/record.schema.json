{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ati-registry.org/schema/record.schema.json",
  "title": "ATI registry record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "registered", "updated", "work", "label", "definitions_version", "statement", "components", "ai_tools", "attestation", "declared_by", "history"],
  "properties": {
    "id": {"type": "string", "pattern": "^ATI-[0-9]{4}-[0-9]{6}$"},
    "status": {"enum": ["active", "disputed", "withdrawn", "removed"]},
    "dispute_note": {"type": "string", "maxLength": 1000},
    "registered": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "updated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "author", "year"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "subtitle": {"type": "string", "maxLength": 200},
        "author": {"type": "string", "minLength": 1, "maxLength": 150},
        "isbn": {"type": "string", "pattern": "^97[89][0-9]{10}$"},
        "year": {"type": "integer", "minimum": 1900, "maximum": 2100},
        "edition": {"type": "string", "maxLength": 80},
        "formats": {"type": "array", "uniqueItems": true, "items": {"enum": ["ebook", "print", "audiobook"]}},
        "url": {"type": "string", "pattern": "^https?://[^\\s]+$", "maxLength": 300}
      }
    },
    "label": {"enum": ["human-authored", "ai-master-edited", "ai-co-authored"]},
    "definitions_version": {"type": "string", "maxLength": 20},
    "statement": {"type": "string", "minLength": 20, "maxLength": 1500},
    "components": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["part", "ai_use"],
        "properties": {
          "part": {"enum": ["cover", "interior_art", "narration", "translation"]},
          "ai_use": {"enum": ["none", "assisted", "generated"]}
        }
      }
    },
    "ai_tools": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accurate", "rights", "self_declared", "terms"],
      "properties": {
        "accurate": {"const": true}, "rights": {"const": true},
        "self_declared": {"const": true}, "terms": {"const": true}
      }
    },
    "declared_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github", "role"],
      "properties": {
        "github": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"},
        "id": {"type": "integer", "minimum": 1},
        "role": {"enum": ["author", "publisher", "representative"]}
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "event"],
        "properties": {
          "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "event": {"enum": ["registered", "withdrawn", "disputed", "dispute resolved", "corrected", "removed"]},
          "by": {"type": "string", "maxLength": 60},
          "issue": {"type": "integer"},
          "note": {"type": "string", "maxLength": 300}
        }
      }
    }
  }
}
